#!/bin/sh
set -eu
repo="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
mkdir -p "$repo/.work/tmp" "$repo/.work/cache/inputs" "$repo/.work/linux-host"

fail() { printf 'setup-dev: %s\n' "$*" >&2; exit 1; }

command -v python3 >/dev/null 2>&1 || fail "python3 is required"
command -v cargo >/dev/null 2>&1 || fail "cargo is required"
command -v go >/dev/null 2>&1 || fail "go is required"

(cd "$repo" && rustc --version >/dev/null) || fail "the toolchain in rust-toolchain.toml is required"
go_version="$(go version | awk '{print $3}')"
[ "$go_version" = "go1.27.3" ] || fail "Go 1.27.3 is required, found $go_version"

sh "$repo/bootstrap/buildlib-run" -c 'import buildlib; print("buildlib ok")' >/dev/null
printf 'setup-dev: ready\n'
